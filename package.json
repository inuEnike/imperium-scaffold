{
  "name": "imperium-scaffold",
  "type": "module",
  "version": "1.0.2",
  "description": "A CLI tool for generating backend module files",
  "repository": {
    "type": "git",
    "url": "https://github.com/inuEnike/imperium-scaffold.git"
  },
  "homepage": "https://github.com/inuEnike/imperium-scaffold#readme",
  "bugs": {
    "url": "https://github.com/inuEnike/imperium-scaffold/issues"
  },
  "bin": {
    "imperium": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepublishOnly": "bun run build",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
